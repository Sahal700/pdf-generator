        <TextObject Name="Regards" Top="36.95" Width="100" Height="15" Text="Warm regards," Font="Arial, 9pt"/>
      </ChildBand>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Top="647.83" Width="718.2" Height="63.95" Guides="85.05,85.05,85.05">
      <TextObject Name="CompanyFooter" Left="1.1" Top="3.95" Width="200" Height="15" Text="[companyHeaders.company_name]" Font="Arial, 9pt, style=Bold"/>
      <TextObject Name="PhoneFooter" Left="1.1" Top="18.95" Width="266.15" Height="15" Text="📞 [companyHeaders.company_phone]" Font="Arial, 9pt"/>
      <TextObject Name="WebsiteFooter" Left="1.1" Top="33.95" Width="266.15" Height="15" Text="🌐 www.ajsurfacepro.com" Font="Arial, 9pt" TextFill.Color="Blue"/>
      <TextObject Name="EmailFooter" Left="1.1" Top="48.95" Width="266.15" Height="15" CanGrow="true" CanBreak="false" Text="📧 [companyHeaders.company_email]" Font="Arial, 9pt" TextFill.Color="Blue"/>
      <TextObject Name="PageNumber" Left="573.1" Top="32.25" Width="118" Height="15" Text="Page [Page] of [TotalPages#]" HorzAlign="Right" Font="Arial, 8pt" TextFill.Color="Gray"/>
