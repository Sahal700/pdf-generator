      <DataHeaderBand Name="DataHeader1" Top="322.15" Width="718.2" Height="57.25" RepeatOnEveryPage="true">
        <ShapeObject Name="HeaderBackground" Left="-0.2" Top="32.25" Width="719.19" Height="25" Border.Color="Gray" Fill.Color="240, 240, 240"/>
        <TextObject Name="ItemNoHeader" Top="37.25" Width="32.13" Height="15" Text="Sl. No." HorzAlign="Center" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="ProductHeader" Left="32" Top="37.25" Width="203.1" Height="15" Text="Description" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="DimensionHeader" Left="235.65" Top="37.25" Width="86" Height="15" Text="Dimensions" HorzAlign="Center" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="AreaHeader" Left="321.1" Top="37.25" Width="59.92" Height="15" Text="Area" HorzAlign="Center" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="UnitHeader" Left="381.55" Top="37.25" Width="41.58" Height="15" Text="Unit" HorzAlign="Center" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="RateHeader" Left="423.55" Top="37.25" Width="82" Height="15" Text="Rate" HorzAlign="Right" Font="Arial, 9pt, style=Bold"/>
