        <TextObject Name="TaxHeader" Left="558.55" Top="37.25" Width="47" Height="15" Text="Tax%" HorzAlign="Center" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="AmountHeader" Left="605.55" Top="37.25" Width="111" Height="15" Text="Amount" HorzAlign="Right" Font="Arial, 9pt, style=Bold"/>
        <TextObject Name="SummaryTitle" Top="8.9" Width="263.4" Height="18" CanGrow="true" CanBreak="false" Text="Quotation Summary" Font="Arial, 11pt, style=Bold" TextFill.Color="DarkBlue"/>
      </DataHeaderBand>
      <DataFooterBand Name="DataFooter1" Top="404.73" Width="718.2" Height="37.8">
        <TextObject Name="Text2" Left="349.65" Top="9.45" Width="368.55" Height="18.9" Border.Color="Navy" CanGrow="true" CanBreak="false" Text="Total Quoted Amount: ₹[dataTable.grand_total]" HorzAlign="Right" Font="Arial Narrow, 12pt, style=Bold"/>
      </DataFooterBand>
    </DataBand>
    <DataBand Name="Data1" Top="445.2" Width="718.2" Height="145.35" CanGrow="true" CanBreak="true">
      <TextObject Name="PaymentTitle" Top="25.35" Width="120" Height="15" Text="Payment Terms" Font="Arial, 10pt, style=Bold" TextFill.Color="DarkBlue"/>
